NICKNAME_ROLE_MAP=
# URLs HTTPS reais de distintivo e faixa. Vazio enquanto os assets não forem fornecidos.
BRAND_BADGE_URL=
BRAND_BANNER_URL=
# Alternativa visual externa: só usada se OCR_BACKEND=gemini.
GEMINI_API_KEY=
VISION_MODEL=gemini-2.5-flash
