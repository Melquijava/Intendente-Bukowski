# Preencha segredos somente no .env privado ou nas vari?veis do Railway.
DISCORD_TOKEN=
GUILD_ID=
PUBLIC_CATEGORY_ID=
INFO_CHANNEL_ID=
ANNOUNCEMENTS_CHANNEL_ID=
RULES_CHANNEL_ID=
SERVICE_CHANNEL_ID=
PRICES_CHANNEL_ID=
WORK_CHANNEL_ID=
REQUESTS_CHANNEL_ID=
LOG_CHANNEL_ID=
ARRIVALS_CHANNEL_ID=
PEAO_ROLE_ID=
# Compatibilidade: P1_ROLE_ID antigo é aceito se PEAO_ROLE_ID não estiver definido.
GERENTE_ROLE_ID=1555083746406047774
ADMIN_ROLE_IDS=
FINANCE_ROLE_IDS=
DATABASE_PATH=data/bukowski.sqlite3
OCR_LANG=por+eng
OCR_BACKEND=tesseract
TESSERACT_CMD=
NICKNAME_FORMAT="{prefix} | {name} | {document}"
